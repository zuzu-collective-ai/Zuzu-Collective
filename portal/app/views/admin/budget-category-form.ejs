<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: `${couple.display_name} — ${category ? category.title : 'New category'}` }) %>
<body class="admin-body">

  <%- include('partials/sidebar', { currentSection: 'couples' }) %>

  <main class="admin-main">
    <header class="admin-header">
      <div>
        <a href="/admin/couples/<%= couple.id %>/budget" class="admin-back">← <%= couple.display_name %> · budget</a>
        <h1 class="admin-title">
          <%= category ? category.title : 'New category' %>
        </h1>
      </div>
    </header>

    <%- include('partials/couple-tabs', { couple, currentTab: 'budget' }) %>

    <%- include('partials/flash', { flash }) %>

    <% if (error) { %>
      <div class="admin-flash admin-flash--error" role="alert"><%= error %></div>
    <% } %>

    <%
      function dollarsValue(cents) {
        if (cents === null || cents === undefined || cents === '') return '';
        const n = Number(cents) / 100;
        if (Number.isNaN(n) || n === 0) return '';
        return n.toFixed(n % 1 === 0 ? 0 : 2);
      }
      function fmtDate(raw) {
        if (!raw) return '';
        try { return new Date(raw).toISOString().slice(0, 10); } catch(_) { return ''; }
      }
      // Booked = category has a contracted_cents set, OR has line items with amount > 0
      const isBooked = (category?.contracted_cents > 0) || (lines && lines.some(l => (l.amount_cents || 0) > 0));
    %>

    <form action="<%= formAction %>" method="post" class="admin-form">
      <fieldset class="admin-fieldset">
        <legend class="admin-legend">Category</legend>

        <div class="admin-row" style="display: grid; grid-template-columns: 110px 1fr 1fr; gap: 1rem;">
          <label class="admin-field">
            <span class="admin-field-label">Number *</span>
            <input type="number" name="category_number" min="1"
                   value="<%= category?.category_number ?? suggestedNumber %>" required>
          </label>
          <label class="admin-field">
            <span class="admin-field-label">Title *</span>
            <input type="text" name="title" required
                   value="<%= category?.title || '' %>" placeholder="Catering">
          </label>
          <label class="admin-field">
            <span class="admin-field-label">Italic suffix</span>
            <input type="text" name="title_emphasis"
                   value="<%= category?.title_emphasis || '' %>" placeholder="(food &amp; bar)">
          </label>
        </div>

        <div style="display:flex; gap:1.5rem; align-items:center; margin:.75rem 0 .25rem;">
          <span class="admin-field-label" style="margin:0;">Status</span>
          <label style="display:flex;align-items:center;gap:.4rem;cursor:pointer;">
            <input type="radio" name="_booked_toggle" value="0" <%= !isBooked ? 'checked' : '' %>> Not booked yet
          </label>
          <label style="display:flex;align-items:center;gap:.4rem;cursor:pointer;">
            <input type="radio" name="_booked_toggle" value="1" <%= isBooked ? 'checked' : '' %>> Booked
          </label>
        </div>

        <div id="section-unbooked" style="<%= isBooked ? 'display:none;' : '' %>margin-top:.75rem;">
          <label class="admin-field" style="max-width:280px;">
            <span class="admin-field-label">Estimated total (USD)</span>
            <input type="text" name="estimated_cents" inputmode="decimal"
                   value="<%= dollarsValue(category?.estimated_cents) %>" placeholder="35000">
            <span class="admin-field-help">Best estimate — shown until booked.</span>
          </label>
        </div>

        <div id="section-booked" style="<%= !isBooked ? 'display:none;' : '' %>margin-top:.75rem;">
          <label class="admin-field" style="max-width:280px;">
            <span class="admin-field-label">Contract total (USD)</span>
            <input type="text" name="contracted_cents" inputmode="decimal"
                   value="<%= dollarsValue(category?.contracted_cents) %>" placeholder="30000">
            <span class="admin-field-help">The full amount of the signed contract.</span>
          </label>
        </div>

        <label class="admin-field" style="max-width:110px; margin-top:.75rem;">
          <span class="admin-field-label">Position</span>
          <input type="number" name="position" min="0" value="<%= category?.position ?? 0 %>">
        </label>
      </fieldset>

      <fieldset class="admin-fieldset" id="payments-fieldset" style="<%= !isBooked ? 'display:none;' : '' %>">
        <legend class="admin-legend">Payments</legend>
        <p class="admin-fieldset-note">
          One row per payment. Enter the amount for each installment and its due date.
          Check <strong>Paid</strong> once the payment has been made.
        </p>

        <div id="line-rows" class="admin-line-rows">
          <%
            const initial = (lines && lines.length) ? lines : [
              { name: '', amount_cents: 0, paid_cents: 0, status_kind: 'upcoming', due_date: null, position: 1 },
            ];
          %>
          <% initial.forEach((l, i) => { %>
            <div class="admin-line-row" data-row>
              <input type="hidden" name="lines[<%= i %>][id]" value="<%= l.id || '' %>">
              <label class="admin-field admin-field--inline">
                <span class="admin-field-label">Description</span>
                <input type="text" name="lines[<%= i %>][name]" value="<%= l.name || '' %>" placeholder="Deposit">
              </label>
              <label class="admin-field admin-field--inline">
                <span class="admin-field-label">Amount</span>
                <input type="text" name="lines[<%= i %>][amount_cents]" inputmode="decimal"
                       value="<%= dollarsValue(l.amount_cents) %>" placeholder="5000">
              </label>
              <label class="admin-field admin-field--inline">
                <span class="admin-field-label">Due date</span>
                <input type="date" name="lines[<%= i %>][due_date]" value="<%= fmtDate(l.due_date) %>">
              </label>
              <label class="admin-field admin-field--inline" style="justify-content:center;">
                <span class="admin-field-label">Paid</span>
                <input type="checkbox" name="lines[<%= i %>][paid]" value="1"
                       <%= (l.status_kind === 'paid' || l.paid_cents >= l.amount_cents && l.amount_cents > 0) ? 'checked' : '' %>
                       style="width:1.2rem;height:1.2rem;margin-top:.35rem;">
              </label>
              <button type="button" class="admin-btn admin-btn--ghost admin-btn--small" data-remove style="align-self:flex-end;">Remove</button>
            </div>
          <% }) %>
        </div>

        <button type="button" id="add-line" class="admin-btn admin-btn--ghost" style="margin-top:.75rem;">+ Add payment</button>
      </fieldset>

      <div class="admin-form-actions">
        <button type="submit" class="admin-btn admin-btn--primary">
          <%= category ? 'Save changes' : 'Add category' %>
        </button>
        <a href="/admin/couples/<%= couple.id %>/budget" class="admin-btn admin-btn--ghost">Cancel</a>
      </div>
    </form>

    <% if (category) { %>
      <div class="admin-danger-zone">
        <h2 class="admin-legend">Danger zone</h2>
        <p>Remove this category and all of its payments from <%= couple.display_name %>'s budget.</p>
        <form action="/admin/couples/<%= couple.id %>/budget/<%= category.id %>/delete" method="post"
              onsubmit="return confirm('Remove <%= category.title %>? This cannot be undone.');">
          <button type="submit" class="admin-btn admin-btn--danger">Remove category</button>
        </form>
      </div>
    <% } %>
  </main>

  <script>
    (function () {
      // ── Booked toggle ─────────────────────────────────────────────────────
      const toggles         = document.querySelectorAll('input[name="_booked_toggle"]');
      const sectionUnbooked  = document.getElementById('section-unbooked');
      const sectionBooked    = document.getElementById('section-booked');
      const paymentsFieldset = document.getElementById('payments-fieldset');

      function applyToggle(booked) {
        sectionUnbooked.style.display  = booked ? 'none' : '';
        sectionBooked.style.display    = booked ? '' : 'none';
        paymentsFieldset.style.display = booked ? '' : 'none';
        if (booked) {
          const est = sectionUnbooked.querySelector('input[name="estimated_cents"]');
          if (est) est.value = '';
        }
      }

      toggles.forEach(r => r.addEventListener('change', () => applyToggle(r.value === '1')));

      // ── Payment row add / remove ──────────────────────────────────────────
      const container = document.getElementById('line-rows');
      const addBtn    = document.getElementById('add-line');
      if (!container || !addBtn) return;

      function nextIndex() {
        return container.querySelectorAll('[data-row]').length;
      }

      function newRow() {
        const i = nextIndex();
        const row = document.createElement('div');
        row.className = 'admin-line-row';
        row.setAttribute('data-row', '');
        row.innerHTML = `
          <input type="hidden" name="lines[${i}][id]" value="">
          <label class="admin-field admin-field--inline">
            <span class="admin-field-label">Description</span>
            <input type="text" name="lines[${i}][name]" placeholder="Final payment">
          </label>
          <label class="admin-field admin-field--inline">
            <span class="admin-field-label">Amount</span>
            <input type="text" name="lines[${i}][amount_cents]" inputmode="decimal" placeholder="0">
          </label>
          <label class="admin-field admin-field--inline">
            <span class="admin-field-label">Due date</span>
            <input type="date" name="lines[${i}][due_date]">
          </label>
          <label class="admin-field admin-field--inline" style="justify-content:center;">
            <span class="admin-field-label">Paid</span>
            <input type="checkbox" name="lines[${i}][paid]" value="1" style="width:1.2rem;height:1.2rem;margin-top:.35rem;">
          </label>
          <button type="button" class="admin-btn admin-btn--ghost admin-btn--small" data-remove style="align-self:flex-end;">Remove</button>
        `;
        container.appendChild(row);
      }

      addBtn.addEventListener('click', newRow);
      container.addEventListener('click', e => {
        if (e.target.matches('[data-remove]')) {
          const row = e.target.closest('[data-row]');
          if (row) row.remove();
        }
      });
    })();
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { couple, title: 'Budget', extraStyles: ['palette.css', 'budget.css'] }) %>
<body>

  <%- include('partials/topbar', { couple, currentPage }) %>

  <style>
    /* Five-column summary grid */
    @media (min-width: 640px) {
      .summary-stats { grid-template-columns: repeat(5, 1fr); }
    }

    /* Booked / not-booked tables */
    .budget-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: var(--space-md);
    }
    .budget-table th {
      font-family: var(--zz-mono);
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--zz-finn-60);
      padding: 0 var(--space-sm) var(--space-sm);
      text-align: left;
      border-bottom: 1px solid var(--zz-finn-20);
    }
    .budget-table th.col-right,
    .budget-table td.col-right { text-align: right; }
    .budget-table td {
      padding: var(--space-sm) var(--space-sm);
      border-bottom: 1px solid var(--zz-finn-20);
      vertical-align: top;
    }
    .budget-table tr:last-child td { border-bottom: 0; }
    .budget-table tr.row-paid-full td { opacity: 0.45; }

    .vendor-name {
      font-family: var(--zz-display);
      font-size: 1.05rem;
      font-style: italic;
      color: var(--zz-finn);
      display: block;
    }
    .vendor-sub {
      display: block;
      font-family: var(--zz-display);
      font-size: 0.875rem;
      color: var(--zz-finn-60);
      margin-top: 1px;
    }
    .amount-td {
      font-family: var(--zz-display);
      font-style: italic;
      font-size: 1.05rem;
      color: var(--zz-finn);
      white-space: nowrap;
    }
    .amount-td--owed { color: var(--zz-tobacco); }
    .amount-td--muted { color: var(--zz-finn-60); }

    .next-due {
      font-family: var(--zz-display);
      font-size: 0.9rem;
      color: var(--zz-ink);
      display: block;
    }
    .next-due--overdue { color: #c0392b; font-weight: 500; }
    .next-due--soon    { color: var(--zz-tobacco); }

    .paid-full-label {
      font-family: var(--zz-mono);
      font-size: 0.6rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--zz-finn);
    }

    .budget-section-note {
      font-family: var(--zz-display);
      font-style: italic;
      font-size: 0.9rem;
      color: var(--zz-finn-60);
      max-width: var(--content-max);
      margin: var(--space-sm) auto var(--space-md);
      padding-inline: var(--space-md);
    }

    /* Stack table on small screens */
    @media (max-width: 639px) {
      .budget-table thead { display: none; }
      .budget-table tr {
        display: block;
        padding: var(--space-sm) 0;
        border-bottom: 1px solid var(--zz-finn-20);
      }
      .budget-table td {
        display: block;
        padding: 2px var(--space-sm);
        border-bottom: 0;
        text-align: left !important;
      }
    }
  </style>

  <%
    function fmtCurrency(cents) {
      const dollars = (cents || 0) / 100;
      const opts = Number.isInteger(dollars)
        ? { maximumFractionDigits: 0 }
        : { minimumFractionDigits: 2, maximumFractionDigits: 2 };
      return '$' + dollars.toLocaleString('en-US', opts);
    }
    function fmtDate(d) {
      return new Date(d).toLocaleDateString('en-US', {
        month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
      });
    }
  %>

  <!-- ── Page header ─────────────────────────────────────────────────────── -->
  <section class="page-header">
    <span class="label page-eyebrow"><%= couple.display_name %></span>
    <h1 class="page-title">Budget</h1>
    <p class="page-subtitle">
      What's booked, what's been paid, and what's still owed.
    </p>
    <% if (lastImported) { %>
      <p style="font-family:var(--zz-mono);font-size:0.6rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--zz-finn-60);margin-top:0.5rem;">
        Budget last updated <%= new Date(lastImported).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) %>
      </p>
    <% } %>
    <% if (spreadsheetUrl) { %>
      <p style="margin-top:0.75rem;">
        <a href="<%= spreadsheetUrl %>" target="_blank" rel="noopener"
           style="font-family:var(--zz-mono);font-size:0.65rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--zz-finn-60);text-decoration:none;border-bottom:1px solid currentColor;">
          View full budget spreadsheet ↗
        </a>
      </p>
    <% } %>
  </section>

  <!-- ── Summary: five figures ────────────────────────────────────────────── -->
  <section class="section summary">
    <div class="summary-stats">
      <div class="stat">
        <div class="stat-label">Total budget</div>
        <div class="stat-number"><%= fmtCurrency(summary.totalBudget) %></div>
      </div>
      <div class="stat">
        <div class="stat-label">Total planned spend</div>
        <div class="stat-number stat-number--accent"><%= fmtCurrency(summary.totalPlannedSpend) %></div>
        <div class="stat-note">Booked + estimated</div>
      </div>
      <div class="stat">
        <div class="stat-label">Paid to date</div>
        <div class="stat-number"><%= fmtCurrency(summary.totalPaid) %></div>
      </div>
      <div class="stat">
        <div class="stat-label">Still owed</div>
        <div class="stat-number"><%= fmtCurrency(summary.totalOwed) %></div>
        <div class="stat-note">To booked vendors</div>
      </div>
      <div class="stat">
        <div class="stat-label">Remaining budget</div>
        <div class="stat-number"><%= fmtCurrency(summary.remainingBudget) %></div>
        <div class="stat-note">After planned spend</div>
      </div>
    </div>
  </section>

  <!-- ── Booked ──────────────────────────────────────────────────────────── -->
  <% if (booked.length > 0) { %>
    <section class="section category">
      <div class="section-head" style="max-width: var(--content-max); margin-inline: auto; padding-inline: var(--space-md);">
        <span class="label">Booked</span>
        <h2 class="section-title"><em>Signed contracts.</em></h2>
      </div>

      <div style="max-width: var(--content-max); margin-inline: auto; padding-inline: var(--space-md); overflow-x: auto;">
        <table class="budget-table">
          <thead>
            <tr>
              <th>Vendor</th>
              <th class="col-right">Contract total</th>
              <th class="col-right">Paid</th>
              <th class="col-right">Still owed</th>
              <th>Next payment due</th>
            </tr>
          </thead>
          <tbody>
            <% booked.forEach(v => {
                 const nextDue = v.nextDue;
                 const nextBalance = nextDue
                   ? Math.max(0, (nextDue.amount_cents || 0) - (nextDue.paid_cents || 0))
                   : 0;
            %>
              <tr class="<%= v.isPaidInFull ? 'row-paid-full' : '' %>">
                <td>
                  <span class="vendor-name"><%= v.vendor || v.title %></span>
                  <span class="vendor-sub"><%= v.title %></span>
                </td>
                <td class="col-right amount-td"><%= fmtCurrency(v.contracted) %></td>
                <td class="col-right amount-td amount-td--muted"><%= fmtCurrency(v.actual) %></td>
                <td class="col-right amount-td<%= v.remaining > 0 ? ' amount-td--owed' : '' %>">
                  <%= v.remaining > 0 ? fmtCurrency(v.remaining) : '—' %>
                </td>
                <td>
                  <% if (v.isPaidInFull) { %>
                    <span class="paid-full-label">Paid in full</span>
                  <% } else if (nextDue) { %>
                    <span class="next-due<%= nextDue._urgency ? ` next-due--${nextDue._urgency}` : '' %>">
                      <%= fmtCurrency(nextBalance) %> · <%= fmtDate(nextDue.due_date) %>
                      <% if (nextDue._urgency === 'overdue') { %>
                        — overdue by <%= Math.abs(nextDue._daysUntil) %> day<%= Math.abs(nextDue._daysUntil) === 1 ? '' : 's' %>
                      <% } else if (nextDue._urgency === 'soon') { %>
                        — <%= nextDue._daysUntil === 0 ? 'due today' : `${nextDue._daysUntil} day${nextDue._daysUntil === 1 ? '' : 's'} away` %>
                      <% } %>
                    </span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  <% } %>

  <!-- ── Not booked yet ─────────────────────────────────────────────────── -->
  <% if (notBooked.length > 0) { %>
    <section class="section category">
      <div class="section-head" style="max-width: var(--content-max); margin-inline: auto; padding-inline: var(--space-md);">
        <span class="label">Not booked yet</span>
        <h2 class="section-title"><em>Still being sourced.</em></h2>
      </div>

      <p class="budget-section-note">
        These are estimates, not quotes. Actual vendor pricing may differ.
      </p>

      <div style="max-width: var(--content-max); margin-inline: auto; padding-inline: var(--space-md); overflow-x: auto;">
        <table class="budget-table">
          <thead>
            <tr>
              <th>Item</th>
              <th class="col-right">Estimated</th>
            </tr>
          </thead>
          <tbody>
            <% notBooked.forEach(v => { %>
              <tr>
                <td>
                  <span class="vendor-name"><%= v.title %></span>
                  <% if (v.vendor && v.vendor !== v.title) { %>
                    <span class="vendor-sub"><%= v.vendor %></span>
                  <% } %>
                </td>
                <td class="col-right amount-td amount-td--muted"><%= fmtCurrency(v.estimated) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  <% } %>

  <%- include('partials/footer', { couple }) %>

</body>
</html>
